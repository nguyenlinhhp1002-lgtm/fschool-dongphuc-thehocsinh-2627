<header class="admin-header">
  <div class="admin-header__brand">
    <span class="admin-header__brand-badge">ĐP</span>
    <span>Đồng phục &amp; Thẻ HS 2026-2027</span>
  </div>
  <nav class="admin-header__nav">
    <a href="/admin" class="<%= activeNav === 'dashboard' ? 'is-active' : '' %>">Trang chủ</a>
    <a href="/admin/hoc-sinh" class="<%= activeNav === 'students' ? 'is-active' : '' %>">Học sinh</a>
    <a href="/admin/dang-ky" class="<%= activeNav === 'registration-list' ? 'is-active' : '' %>">Đăng ký &amp; phát đồ</a>
    <a href="/admin/dang-ky/upload" class="<%= activeNav === 'registration-upload' ? 'is-active' : '' %>">Tải file đăng ký</a>
    <a href="/admin/dang-ky/loi" class="<%= activeNav === 'registration-issues' ? 'is-active' : '' %>">Cần xử lý</a>
    <a href="/admin/ds-no" class="<%= activeNav === 'ds-no' ? 'is-active' : '' %>">File DS đăng ký có size</a>
    <a href="/admin/the-hoc-sinh" class="<%= activeNav === 'cards' ? 'is-active' : '' %>">Thẻ học sinh</a>
    <a href="/admin/bao-cao" class="<%= activeNav === 'reports' ? 'is-active' : '' %>">Báo cáo</a>
    <a href="/admin/danh-muc" class="<%= activeNav === 'categories' ? 'is-active' : '' %>">Danh mục</a>
    <a href="/admin/dot-dang-ky" class="<%= activeNav === 'batches' ? 'is-active' : '' %>">Đợt đăng ký</a>
  </nav>
  <div class="admin-header__user">
    <span><%= session.username %> (<%= session.role === 'admin' ? 'toàn quyền' : 'chỉ xem' %>)</span>
    <form action="/admin/logout" method="post" style="margin:0">
      <button class="btn-link" type="submit">Đăng xuất</button>
    </form>
  </div>
</header>
