<!doctype html>
<html lang="vi">
<head><%- include('../partials/head', { pageTitle }) %></head>
<body class="admin-page">
<%
  const qs = new URLSearchParams();
  if (filters.q) qs.set('q', filters.q);
  if (filters.lop) qs.set('lop', filters.lop);
  if (filters.khoi) qs.set('khoi', filters.khoi);
  const returnTo = '/admin/dang-ky' + (qs.toString() ? '?' + qs.toString() : '');
%>
  <%- include('../partials/adminNav', { session, activeNav }) %>
  <main class="admin-main">
    <h1>Danh sách đăng ký &amp; phát đồ</h1>
    <p class="admin-main__desc">Bố cục theo định dạng "DS đăng ký có size". Bấm vào nút trạng thái để đánh dấu đã phát/chưa phát; sửa size trực tiếp trong ô rồi bấm 💾.</p>

    <form method="get" class="form-row">
      <div class="form-field"><label>Tìm mã HS / tên</label><input type="text" name="q" value="<%= filters.q %>" /></div>
      <div class="form-field">
        <label>Lớp</label>
        <select name="lop">
          <option value="">Tất cả</option>
          <% lopKhoiList.forEach(l => { %><option value="<%= l.lop %>" <%= filters.lop === l.lop ? 'selected' : '' %>><%= l.lop %></option><% }) %>
        </select>
      </div>
      <div class="form-field">
        <label>Khối</label>
        <select name="khoi">
          <option value="">Tất cả</option>
          <% [...new Set(lopKhoiList.map(l=>l.khoi))].forEach(k => { %><option value="<%= k %>" <%= filters.khoi === k ? 'selected' : '' %>><%= k %></option><% }) %>
        </select>
      </div>
      <button class="btn btn-outline" type="submit">Lọc</button>
      <a class="btn btn-primary" href="/admin/ds-no/xuat.xlsx<%= qs.toString() ? '?' + qs.toString() : '' %>">⭳ Tải file DS đăng ký có size</a>
    </form>
    <p style="font-size:0.78rem; color:var(--text-muted); margin:-8px 0 12px">File tải xuống lấy đúng dữ liệu mới nhất đang hiển thị ở đây (kể cả size vừa sửa trực tiếp trên bảng), theo bộ lọc Mã HS/tên, Lớp, Khối hiện tại.</p>

    <% if (session.role === 'admin' && filters.lop) { %>
    <div class="card" style="padding:12px 16px">
      <form method="post" action="/admin/dang-ky/phat-hang-loat" class="form-row" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="lop" value="<%= filters.lop %>" />
        <input type="hidden" name="returnTo" value="<%= returnTo %>" />
        <div class="form-field">
          <label>Phát hàng loạt cho cả lớp <%= filters.lop %></label>
          <select name="codePrefix" required>
            <% categories.forEach(c => { %><option value="<%= c.code_prefix %>"><%= c.ten_hien_thi %></option><% }) %>
          </select>
        </div>
        <button class="btn btn-amber" type="submit">Đánh dấu đã phát cả lớp</button>
      </form>
    </div>
    <% } %>

    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>
            <th class="sticky-col" rowspan="2">Mã HS</th><th rowspan="2">Họ tên</th><th rowspan="2">Lớp</th>
            <% categories.forEach(c => { %><th colspan="<%= c.co_size ? 3 : 2 %>"><%= c.ten_hien_thi %></th><% }) %>
          </tr>
          <tr>
            <% categories.forEach(c => { %>
              <th>SL</th><% if (c.co_size) { %><th>Size</th><% } %><th>Trạng thái</th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td class="sticky-col"><%= r.student.ma_hs %></td>
              <td><%= r.student.ho_ten %></td>
              <td><%= r.student.lop %></td>
              <% r.cells.forEach(cell => { %>
                <% if (cell.soLuong === 0) { %>
                  <td colspan="<%= cell.coSize ? 3 : 2 %>" style="color:var(--border-soft); text-align:center">–</td>
                <% } else { %>
                  <td class="num"><%= cell.soLuong %></td>
                  <% if (cell.coSize) { %>
                    <td>
                      <% if (session.role === 'admin') { %>
                      <form method="post" action="/admin/dang-ky/cap-nhat" class="pill-form js-inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="maHs" value="<%= r.student.ma_hs %>" />
                        <input type="hidden" name="codePrefix" value="<%= cell.codePrefix %>" />
                        <input type="hidden" name="hanhDong" value="set_size" />
                        <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                        <input type="text" name="giaTri" value="<%= cell.size || '' %>" placeholder="size" />
                        <button class="btn-sm" type="submit" title="Lưu size">💾</button>
                      </form>
                      <% } else { %><%= cell.size || '—' %><% } %>
                    </td>
                  <% } %>
                  <td>
                    <% if (session.role === 'admin') { %>
                    <form method="post" action="/admin/dang-ky/cap-nhat" class="js-inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <input type="hidden" name="maHs" value="<%= r.student.ma_hs %>" />
                      <input type="hidden" name="codePrefix" value="<%= cell.codePrefix %>" />
                      <input type="hidden" name="hanhDong" value="toggle_phat" />
                      <input type="hidden" name="giaTri" value="<%= cell.trangThaiPhat === 'da_phat_du' ? '0' : '1' %>" />
                      <input type="hidden" name="returnTo" value="<%= returnTo %>" />
                      <button class="badge <%= cell.trangThaiPhat === 'da_phat_du' ? 'badge--success' : cell.trangThaiPhat === 'mot_phan' ? 'badge--warn' : 'badge--gray' %>" style="border:none;cursor:pointer" type="submit">
                        <%= cell.trangThaiPhat === 'da_phat_du' ? 'Đã phát' : cell.trangThaiPhat === 'mot_phan' ? `${cell.daPhat}/${cell.soLuong}` : 'Chưa phát' %>
                      </button>
                    </form>
                    <% } else { %>
                      <span class="badge <%= cell.trangThaiPhat === 'da_phat_du' ? 'badge--success' : cell.trangThaiPhat === 'mot_phan' ? 'badge--warn' : 'badge--gray' %>"><%= cell.trangThaiPhat === 'da_phat_du' ? 'Đã phát' : cell.trangThaiPhat === 'mot_phan' ? `${cell.daPhat}/${cell.soLuong}` : 'Chưa phát' %></span>
                    <% } %>
                  </td>
                <% } %>
              <% }) %>
            </tr>
          <% }) %>
          <% if (rows.length === 0) { %>
            <tr><td colspan="99" style="text-align:center;color:var(--text-muted)">Không có học sinh nào khớp bộ lọc.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <p style="font-size:0.8rem; color:var(--text-muted); margin-top:8px">Tổng <%= rows.length %> học sinh có đăng ký.</p>
  </main>
</body>
</html>
