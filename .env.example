PORT=3000
SESSION_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-chay-that
NODE_ENV=development

# Chi can dien 2 dong duoi khi deploy that (vi du len Render) va muon dung Turso.
# Bo trong khi chay local - app se tu dung file SQLite local qua libsql (storage/dong-phuc.db),
# khong can tai khoan Turso.
# TURSO_DATABASE_URL=libsql://ten-database-cua-ban.turso.io
# TURSO_AUTH_TOKEN=

# Tuy chon: tu tao 1 tai khoan admin dau tien khi khoi dong, neu bang admins con rong.
# Danh cho moi truong khong co Shell/CLI de chay scripts/admin-users.js (vd Render goi Free
# khong co tab Shell). An toan de giu lai lau dai - chi tao 1 lan duy nhat, lan sau bo qua.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=doi-mat-khau-nay
